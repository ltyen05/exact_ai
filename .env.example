# EXACT 2026 Environment Configuration Template
# 
# Copy file này thành .env và điền thông tin của bạn
# DO NOT commit .env vào git!

# ============================================================================
# LangSmith Configuration (Observability & Tracing)
# ============================================================================
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Generate from: https://smith.langchain.com/ → Settings → API Keys
LANGSMITH_API_KEY=ls_YOUR_API_KEY_HERE

# Project name in LangSmith dashboard
LANGSMITH_PROJECT=exact-2026

# Legacy aliases LANGCHAIN_TRACING_V2, LANGCHAIN_ENDPOINT, LANGCHAIN_API_KEY,
# and LANGCHAIN_PROJECT are also accepted.

# ============================================================================
# LLM Configuration (OpenRouter, used by api.py)
# ============================================================================
OR_TOKEN=sk-or-v1_YOUR_API_KEY_HERE
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=qwen/qwen-2.5-7b-instruct

# ============================================================================
# LLM Configuration (local vLLM server)
# ============================================================================
# Base URL của vLLM server
EXACT_LLM_BASE_URL=http://localhost:8000/v1

# Hugging Face/local served model name (vi du)
EXACT_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# API key (EMPTY cho local server)
EXACT_LLM_API_KEY=EMPTY

# ============================================================================
# Optional: Debug Mode
# ============================================================================
# DEBUG=true
