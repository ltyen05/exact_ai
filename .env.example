# EXACT 2026 Environment Configuration Template
# 
# Copy file này thành .env và điền thông tin của bạn
# DO NOT commit .env vào git!

# ============================================================================
# LangSmith Configuration (Observability & Tracing)
# ============================================================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# Generate from: https://smith.langchain.com/ → Settings → API Keys
LANGCHAIN_API_KEY=ls_YOUR_API_KEY_HERE

# Project name in LangSmith dashboard
LANGCHAIN_PROJECT=exact-2026

# ============================================================================
# LLM Configuration (vLLM Server)
# ============================================================================
# Base URL của vLLM server
EXACT_LLM_BASE_URL=http://localhost:8000/v1

# Model name (ví dụ)
EXACT_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# API key (EMPTY cho local server)
EXACT_LLM_API_KEY=EMPTY

# ============================================================================
# Optional: Debug Mode
# ============================================================================
# DEBUG=true
